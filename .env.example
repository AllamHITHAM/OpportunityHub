# Local development values below. For staging/production, set:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://<this API's real staging/production domain>
#   FRONTEND_URL=https://<the deployed Flutter Web build's real domain>
# Never commit real staging/production values here -- this file only ever
# documents the shape each variable should take.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Base URL of the deployed Flutter Web build (not this API's own URL) --
# used only to build absolute links for outbound emails (Phase 7A-4.1).
# Adjust the port to whatever `flutter run -d chrome --web-port=...` (or
# your web build's dev server) actually uses locally; 8080 is a common
# convention, not a requirement.
FRONTEND_URL=http://localhost:8080

# Comma-separated list of exact origins allowed to make cross-origin
# requests to /api/* (see config/cors.php), e.g.
# "https://staging.example.com". Leave blank for local development -- a
# safe loopback-only fallback (any http(s)://localhost or 127.0.0.1
# origin/port) applies automatically; never set this to "*".
CORS_ALLOWED_ORIGINS=

# Comma-separated proxy IP(s)/CIDR(s) to trust for X-Forwarded-* headers
# (correct https:// URL generation behind a TLS-terminating reverse
# proxy/PaaS load balancer -- see bootstrap/app.php), or the literal "*"
# to trust whichever proxy is directly connecting. Leave blank for local
# development, where there is no proxy. Only set this once the real
# staging infrastructure is known.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# REQUIRED to stay "database" in every real environment, not just local --
# ReleaseQuizResultJob is dispatched with ->delay() to a future timestamp,
# which QUEUE_CONNECTION=sync silently ignores (running the job
# immediately instead of at the scheduled time). A persistent
# `php artisan queue:work` process must run continuously wherever this
# app is deployed; see docs/DEPLOYMENT.md for the exact command.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" (writes to storage/logs instead of sending) is acceptable for
# local development only. Every real environment needs a genuine
# transport (smtp/ses/postmark/resend/etc.) with real credentials set
# only in that environment's own .env, never committed here. Every
# outbound email link is built from FRONTEND_URL/APP_URL -- see those
# above -- never hardcoded, so setting them correctly is what keeps email
# links correct once MAIL_MAILER points at a real transport.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Phase 8A-6: AI CV Skill Extraction (Groq). Leave blank in development
# if you don't have a key -- the feature fails safely with a controlled
# 503 rather than crashing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

VITE_APP_NAME="${APP_NAME}"
